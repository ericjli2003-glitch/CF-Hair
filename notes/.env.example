# Copy to .env (gitignored) or export in your shell. Nothing here is required for `npm run demo`.

# Claude writes each note. Without it, generate uses clearly labelled mock templates.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5, see settings.json)
# NOTES_MODEL=

# Live client data from the website's booking API (see docs/ARCHITECTURE.md)
BOOKING_API_URL=http://localhost:3000
AGENT_API_KEY=

# Handwrytten (default provider). List ids with: npm run notes -- catalog
HANDWRYTTEN_API_KEY=
HANDWRYTTEN_CARD_ID=
HANDWRYTTEN_FONT=

# Optional
# NOTES_TODAY=2026-10-09          pretend today is this date (salon time)
# NOTES_HISTORY=data/history.json sent-history ledger location
# NOTES_OUT_DIR=out
# NODE_USE_ENV_PROXY=1            only behind an HTTPS proxy, so proof fonts can be fetched
