// CF Hair Salon booking schema.
// Dev uses SQLite. Production uses Postgres: scripts/prepare-db.mjs switches the
// provider below automatically based on DATABASE_URL (file: vs postgres://).
// The schema avoids provider-specific features (no enums, no scalar lists) so it
// works unchanged on both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String         @id
  name        String
  category    String
  durationMin Int
  priceCAD    Int
  description String
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  staff       StaffService[]
  bookings    Booking[]
}

model Staff {
  id        String         @id
  name      String
  role      String
  bio       String
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  services  StaffService[]
  bookings  Booking[]
  locks     SlotLock[]
  timeOff   TimeOff[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Customer {
  id                String            @id @default(cuid())
  name              String
  phone             String            @unique // E.164
  email             String?
  // JSON: {line1, line2?, city, province, postalCode, country}
  mailingAddress    String?
  birthday          String? // YYYY-MM-DD
  preferredLanguage String            @default("en-US") // en-US | zh-CN | zh-HK | ko-KR
  tags              String            @default("[]") // JSON string array
  referredBy        String? // free text, editable by the owner
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookings          Booking[]
  caller            CallerProfile?
  smsConsent        SmsConsent?
  campaignMessages  CampaignMessage[]
  calls             Call[]
  cards             Card[]
}

// Phone agent memory, keyed by E.164 phone. Linked to the Customer with the same
// phone when one exists; preferredLanguage is kept in sync on both rows.
model CallerProfile {
  phone             String    @id
  name              String?
  preferredLanguage String    @default("en-US")
  callCount         Int       @default(0)
  lastCallAt        DateTime?
  customerId        String?   @unique
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Booking {
  id             String     @id @default(cuid())
  serviceId      String
  staffId        String
  customerId     String
  start          DateTime
  end            DateTime
  status         String     @default("confirmed") // confirmed | cancelled | completed | no-show
  source         String     @default("web") // web | phone | walk-in | admin
  notes          String?
  priceCAD       Int        @default(0)
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  service        Service    @relation(fields: [serviceId], references: [id])
  staff          Staff      @relation(fields: [staffId], references: [id])
  customer       Customer   @relation(fields: [customerId], references: [id])
  locks          SlotLock[]

  @@index([staffId, start])
  @@index([start])
  @@index([customerId])
}

// One row per occupied 15-minute block per stylist. The composite primary key is
// the database-level guarantee against double-booking, even under concurrent
// requests: the second insert for the same stylist and block fails.
model SlotLock {
  staffId   String
  slotStart DateTime
  bookingId String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([staffId, slotStart])
  @@index([bookingId])
}

// Time a stylist is out (lunch, a holiday, an appointment), or, with no staffId, the whole
// salon. Online booking and the phone agent treat it as busy, like a booking.
model TimeOff {
  id        String   @id @default(cuid())
  staffId   String?
  start     DateTime
  end       DateTime
  reason    String?
  createdAt DateTime @default(now())
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([start])
  @@index([staffId, start])
}

model Message {
  id         String   @id @default(cuid())
  callerName String
  phone      String
  message    String
  urgency    String   @default("normal") // low | normal | high
  source     String   @default("phone") // phone | web | sms
  status     String   @default("new") // new | done
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Promotional SMS (CASL). See docs/sms-compliance.md.
// ---------------------------------------------------------------------------

// Current promotional SMS consent for one phone number (E.164). Keyed by phone so a
// STOP from a number that is not (yet) a client is still honoured. Booking
// confirmations and reminders are transactional and never read this table.
model SmsConsent {
  phone              String    @id
  customerId         String?   @unique
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status             String    @default("none") // none | express | implied | withdrawn
  source             String? // web | admin | phone | keyword | visit (implied) | import
  wording            String? // exact consent wording shown or spoken
  language           String? // language the wording was shown in
  consentedAt        DateTime? // when express or implied consent started
  impliedBasis       String? // e.g. "Paid visit on 2026-03-14 (existing business relationship)"
  impliedVisitAt     DateTime?
  impliedExpiresAt   DateTime? // paid visit + 2 years
  withdrawnAt        DateTime?
  phoneAskDeclinedAt DateTime? // caller said no to the phone agent's opt-in question; never ask again
  // Transactional sender (confirmations, reminders): set when the client replied STOP
  // to that number. The carrier blocks those texts anyway; reminders fall back to email.
  txnOptedOutAt      DateTime?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@index([status])
}

// Append-only proof log. Rows are never updated or deleted by the app.
model ConsentEvent {
  id         String   @id @default(cuid())
  phone      String
  customerId String?
  type       String // express | implied | implied_expired | withdrawn | resubscribed | declined | help | txn_opted_out | txn_resubscribed
  source     String // web | admin | phone | keyword | visit | system
  actor      String   @default("system") // customer | owner | agent | system
  wording    String? // exact wording shown, spoken or received (inbound keyword text)
  language   String?
  detail     String? // JSON: extra context (booking id, campaign id, inbound message sid...)
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
  @@index([type, createdAt])
}

model Campaign {
  id             String            @id @default(cuid())
  name           String
  // JSON {"en-US": "...", "zh-CN"?: "...", "zh-HK"?: "...", "ko-KR"?: "..."}; en-US required
  bodies         String
  // JSON {type: all|recent|lapsed|stylist|category|birthday, days?, staffId?, category?}
  audience       String
  includeImplied Boolean           @default(false)
  status         String            @default("draft") // draft | scheduled | sending | sent | cancelled
  requestedAt    DateTime? // what the owner asked for (null = send now)
  scheduledAt    DateTime? // after quiet-hours adjustment
  startedAt      DateTime?
  completedAt    DateTime?
  dryRun         Boolean           @default(false) // sent through the offline outbox
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       CampaignMessage[]

  @@index([status, scheduledAt])
}

model CampaignMessage {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone       String
  name        String
  language    String    @default("en-US")
  body        String // final text including sender ID and opt-out footer
  segments    Int       @default(1)
  encoding    String    @default("GSM-7") // GSM-7 | UCS-2
  consentType String? // express | implied (at queue time)
  isTest      Boolean   @default(false)
  status      String    @default("queued") // queued | sent | delivered | failed | skipped
  skipReason  String? // no_consent | withdrawn | implied_excluded | implied_expired | frequency_cap | quiet_hours | invalid_phone | duplicate
  error       String?
  twilioSid   String?   @unique
  dryRun      Boolean   @default(false)
  sendAfter   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId, status])
  @@index([status, sendAfter])
  @@index([phone, sentAt])
}

// Small key/value settings the owner can change in the admin (frequency cap, test phone).
model AppSetting {
  key   String @id
  value String
}

// Log of transactional notices (booking confirmations and reminders) by SMS or email,
// including ones skipped because the client opted out of the transactional sender.
model Notification {
  id        String   @id @default(cuid())
  kind      String // confirmation | reminder
  channel   String // sms | email | none
  to        String
  subject   String?
  body      String
  status    String // sent | dry_run | skipped | failed
  reason    String? // txn_opted_out | no_email | not_configured | provider error text
  bookingId String?
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([to, createdAt])
}

// ---------------------------------------------------------------------------
// Phone receptionist call log. See docs/ARCHITECTURE.md, "Calls".
// ---------------------------------------------------------------------------

// One row per phone call, upserted by Twilio's callSid when the call ends (and again
// if the phone agent learns more, e.g. a transfer result). Linked to the Customer
// with the same phone. The transcript is cleared after CALL_TRANSCRIPT_DAYS (default
// 90); the summary is kept.
model Call {
  id                  String    @id @default(cuid())
  callSid             String    @unique
  fromPhone           String? // E.164, null when caller ID was withheld
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  startedAt           DateTime
  endedAt             DateTime?
  durationSec         Int       @default(0)
  language            String    @default("en-US") // en-US | zh-CN | zh-HK | ko-KR
  languageSource      String    @default("default") // saved | detected | keypad | asked | default
  outcome             String // booked | rescheduled | cancelled | message | transferred | info | abandoned | spam
  summary             String // 1 to 3 plain English sentences for the owner
  bookingId           String?
  messageId           String?
  transferResult      String? // answered | no-answer | busy | failed
  smsConsent          String? // yes | no | not-asked
  transcript          String? // JSON [{role, text, lang?, at?}]; null once cleared
  transcriptClearedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([startedAt])
  @@index([fromPhone, startedAt])
  @@index([outcome, startedAt])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Handwritten cards approval queue. See docs/ARCHITECTURE.md, "Handwritten cards".
// ---------------------------------------------------------------------------

// One upload from the notes pipeline (one campaign run).
model CardBatch {
  id           String   @id @default(cuid())
  campaignId   String
  campaignName String
  occasion     String
  generatedAt  DateTime
  mock         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cards        Card[]

  @@index([campaignId, generatedAt])
  @@index([createdAt])
}

// One card. Status: pending -> approved | skipped -> sent | failed. Nothing is mailed
// until the owner approves it; approvals per calendar month are capped (AppSetting
// cards.monthlyCap).
model Card {
  id              String    @id @default(cuid())
  batchId         String
  batch           CardBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  campaignId      String // copied from the batch: (campaignId, clientRef) is the idempotency key while pending
  clientRef       String // customer id or phone, as sent by the pipeline
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name            String
  mailingAddress  String // JSON {line1, line2?, city, province, postalCode, country}
  stylistName     String
  lastServiceName String?
  cardDesign      String
  message         String
  messageAlt      String?
  altLanguage     String? // zh-CN | zh-HK | ko-KR
  maxChars        Int
  mock            Boolean   @default(false) // template text, not written for this client
  status          String    @default("pending") // pending | approved | skipped | sent | failed
  editedAt        DateTime?
  approvedAt      DateTime?
  skippedAt       DateTime?
  provider        String? // handwrytten | plotter
  providerOrderId String?
  sentAt          DateTime?
  costCAD         Float?
  failedAt        DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([campaignId, clientRef, status])
  @@index([batchId, status])
  @@index([status, approvedAt])
  @@index([customerId])
}
