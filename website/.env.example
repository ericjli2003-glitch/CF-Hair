# Database. Local dev uses SQLite; production uses Postgres (Neon or Supabase).
# scripts/prepare-db.mjs switches the Prisma provider automatically from this URL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Owner login for /admin
ADMIN_PASSWORD="change-me"
# Optional: secret used to sign the admin session cookie (defaults to one derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=""

# Shared key for the phone agent and notes pipeline (sent as the x-api-key header)
AGENT_API_KEY="change-me-too"

# Optional SMS confirmations via Twilio. Leave blank to disable (no-op).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# or use a Messaging Service instead of a from number
TWILIO_MESSAGING_SERVICE_SID=""
