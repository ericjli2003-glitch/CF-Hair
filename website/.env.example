# Database. Local dev uses SQLite; production uses Postgres (Neon or Supabase).
# scripts/prepare-db.mjs switches the Prisma provider automatically from this URL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Owner login for /admin
ADMIN_PASSWORD="change-me"
# Optional: secret used to sign the admin session cookie (defaults to one derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=""

# Shared key for the phone agent and notes pipeline (sent as the x-api-key header)
AGENT_API_KEY="change-me-too"

# Twilio SMS. Leave the account blank for the offline outbox: nothing is sent, and
# promotions, confirmations and reminders are recorded and shown in the admin.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Two senders, on purpose: a STOP blocks the sender it was sent to, so promotions use
# their own number and a promo opt-out never stops appointment texts.
# Appointment confirmations and reminders (Messaging Service SID or a number):
TWILIO_TXN_MESSAGING_SERVICE_SID=""
TWILIO_TXN_FROM=""
# Promotional campaigns (required to send campaigns live; must differ from the above):
TWILIO_PROMO_MESSAGING_SERVICE_SID=""
TWILIO_PROMO_FROM=""
# Older single-sender variables, still used for appointment texts if TWILIO_TXN_* are blank:
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Twilio Advanced Opt-Out answers English STOP/START/HELP itself; the app then does not reply twice.
TWILIO_ADVANCED_OPT_OUT="true"
# Public URL of this site (no trailing slash): status callbacks and webhook signature checks.
PUBLIC_BASE_URL=""
# Force the offline outbox even with Twilio configured (1 to enable).
SMS_DRY_RUN=""

# Promotional SMS settings
# Phone that gets "Send test" (the owner can also set it on the Promotions page).
SMS_OWNER_PHONE=""
# Frequency cap default: at most MAX promotional texts per DAYS days per client.
SMS_FREQUENCY_CAP_MAX="4"
SMS_FREQUENCY_CAP_DAYS="30"
# Optional short link added to promos, to a page with the salon's mailing address and phone.
SMS_INFO_URL=""
# Cost estimate per segment in USD (Twilio Canada list price plus a typical carrier fee).
SMS_COST_PER_SEGMENT_USD="0.0163"
# Queue throttling: texts per run and milliseconds between texts.
SMS_SEND_BATCH="50"
SMS_SEND_INTERVAL_MS="250"
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/sms/queue.
CRON_SECRET=""

# Optional email for reminders when a client turned off appointment texts (Resend).
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional "Draft with Claude" in the campaign composer. Hidden when the key is blank.
ANTHROPIC_API_KEY=""
ANTHROPIC_PROMO_MODEL="claude-sonnet-5-5"

# Phone receptionist call log: days to keep transcripts (summaries are kept).
CALL_TRANSCRIPT_DAYS="90"
# Handwritten cards: defaults until the owner saves them in the Cards tab.
CARDS_MONTHLY_CAP="40"
CARDS_PRICE_CAD="8.50"
