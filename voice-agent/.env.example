# Copy to .env and fill in. Never commit .env.

# Claude: either an API key, or workload identity federation (no key; see README, "Deploying").
ANTHROPIC_API_KEY=
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=<organization UUID>
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_IDENTITY_TOKEN_FILE=<path to the OIDC token; Render sets this itself>
# Default model. claude-haiku-4-5 lowers latency and cost (see README).
ANTHROPIC_MODEL=claude-sonnet-5-5
# low keeps replies quick on the phone. Ignored for Haiku.
ANTHROPIC_EFFORT=low
# off (default): no extended thinking on Claude Sonnet 5.5, so the first words come sooner.
# adaptive: let the model think before answering (slower, sometimes smarter on hard requests).
ANTHROPIC_THINKING=off
# auto: server-side refusal fallbacks on models that support them. on | off to force.
CLAUDE_FALLBACKS=auto
# 1h (default) keeps the system prompt cached between calls; 5m is cheaper if calls are frequent.
PROMPT_CACHE_TTL=1h

# Booking API (the website in ../website). Same key as the website's AGENT_API_KEY.
BOOKING_API_URL=http://localhost:3000
AGENT_API_KEY=
BOOKING_API_TIMEOUT_MS=5000
CALLER_LOOKUP_TIMEOUT_MS=1500
# How long the incoming-call webhook waits for a returning caller's saved language before opening in English.
OPENING_LOOKUP_TIMEOUT_MS=1000
# true = use the built-in in-memory mock API instead of BOOKING_API_URL
MOCK_API=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only set to false for local testing without Twilio.
TWILIO_VALIDATE_SIGNATURE=true
# Public https URL Twilio uses to reach this server (your ngrok or Fly URL), no trailing slash.
# Not needed on Render: RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=
# Live transfer target in E.164.
# Owner mobile or a second line, never the salon main number (that line forwards here: transfers would loop).
SALON_FORWARD_NUMBER=
# The salon public number that forwards unanswered calls here (defaults to shared/salon.json phone).
SALON_MAIN_NUMBER=

# Server
PORT=8080
# Post a low-urgency callback message when a caller hangs up mid-conversation.
CALLBACK_ON_ABANDON=true
# Extra wait after the goodbye before hanging up.
END_CALL_GRACE_MS=1200
# Online booking site the agent mentions when asked if it is an AI, or for the website.
# The spoken form is worked out automatically; override it if it sounds wrong.
BOOKING_WEBSITE=cf-hair-salon.vercel.app
# BOOKING_WEBSITE_SPOKEN=C F hair salon dot C A
# Language identification for new callers: a copy of the call audio goes to ElevenLabs Scribe v2
# Realtime until the first sentence comes back with its language (English, Mandarin, Cantonese,
# Korean...). Needs an ElevenLabs API key with Speech to Text permission. LANGUAGE_ID=off turns it off.
ELEVENLABS_API_KEY=
# LANGUAGE_ID_MAX_MS=20000
# Languages spoken by ElevenLabs directly instead of through Twilio, with ELEVENLABS_DIRECT_MODEL.
# For Cantonese with Eleven v4 Turbo (Twilio only accepts the v2 models, which do not list Cantonese):
# ELEVENLABS_DIRECT_LANGUAGES=zh-HK plus CR_ZH_HK_VOICE=<ElevenLabs voice id>. The key then also
# needs Text to Speech permission.
# ELEVENLABS_DIRECT_LANGUAGES=zh-HK
# ELEVENLABS_DIRECT_MODEL=eleven_v4_turbo
# Speech-to-speech test line (README, "Speech-to-speech test line"): OpenAI Realtime answers a
# second Twilio number whose webhook is https://<host>/s2s/twiml. Off unless OpenAI login is set:
# either workload identity (no key; on Render, OPENAI_IDENTITY_TOKEN_FILE is set by Render) ...
# OPENAI_IDENTITY_PROVIDER_ID=idp_...
# OPENAI_SERVICE_ACCOUNT_ID=
# OPENAI_IDENTITY_TOKEN_FILE=
# ... or a plain API key (workload identity wins when both are set).
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1     gpt-realtime-2.1-mini is faster and cheaper
# OPENAI_REALTIME_VOICE=marin
# OPENAI_REASONING_EFFORT=low                minimal is faster; off sends none
# OPENAI_VAD_SILENCE_MS=500                  silence that ends the caller's turn
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   caller transcripts for the call log; off to skip
# Turn-taking (how fast the agent answers after the caller stops talking). Off by default; try:
# CR_EN_US_SPEECH_MODEL=flux   Deepgram Flux detects the end of a turn itself (Twilio: 200 to 600 ms faster)
# CR_EOT_THRESHOLD=0.7         Flux only: 0.5 answers sooner, 0.9 waits longer (default 0.8)
# CR_SPEECH_TIMEOUT_MS=800     silence before the words are sent, 600 to 5000 (with Flux, a maximum)
# Ask which language (all four, with keypad options) if nothing understandable is heard this long
# after the greeting. 0 turns it off.
SILENCE_NUDGE_MS=5000
# Print each caller sentence as heard, and each reply, to the server log. For testing only: the
# log then holds callers' names and details, so turn it off before real clients call.
LOG_TRANSCRIPTS=false
# Ask the one promotional-text question after a phone booking (adds a question to every call).
PHONE_SMS_OPTIN=false
# Openings fetched at call start so common availability questions skip a lookup (faster replies).
# Comma-separated service ids from shared/salon.json, or off.
PREFETCH_SERVICES=mens-cut,womens-cut,kids-cut
# On a redeploy (SIGTERM), how long calls in progress may continue before the old server exits.
DRAIN_TIMEOUT_MS=280000
# Optional overrides
# WELCOME_GREETING=Hi, CF Hair Salon.
# SALON_JSON_PATH=../shared/salon.json
# LOG_DIR=./logs
# DATA_DIR=./data

# Calls tab summaries: a small, cheap model writes 1 to 3 sentences per call for the owner.
CALL_SUMMARY_MODEL=claude-haiku-4-5
# off = template summaries only (no Claude call)
CALL_SUMMARY=on

# Language detection (see README, "Languages and caller memory")
# Detect Chinese and Korean from transcripts and switch automatically.
LANG_AUTODETECT=true
# Ask one four-language question when the evidence is weak, instead of guessing.
LANG_ASK_QUESTION=true
# en-US (default) or multi. multi = Deepgram automatic language detection at call start. It does
# not cover Mandarin, Cantonese or Korean today, so it only helps once Deepgram adds them.
CR_START_TRANSCRIPTION_LANGUAGE=en-US
CR_START_SPEECH_MODEL=nova-3-general

# Optional ElevenLabs voices inside ConversationRelay. Off by default until the owner hears samples.
# Applies to English, Mandarin and Korean; Cantonese stays on Google (not in Flash or Turbo v2.5).
# CR_TTS_PROVIDER=ElevenLabs
# CR_ELEVENLABS_VOICE=<voice id from the ElevenLabs voice library>
# CR_ELEVENLABS_MODEL=flash_v2_5

# Per-language voice and speech settings (defaults in src/languages.ts). Examples:
# CR_EN_US_VOICE=en-US-Chirp3-HD-Aoede
# CR_ZH_CN_VOICE=cmn-CN-Chirp3-HD-Aoede
# CR_ZH_HK_VOICE=yue-HK-Chirp3-HD-Aoede
# CR_ZH_HK_TRANSCRIPTION_PROVIDER=Deepgram
# CR_ZH_HK_SPEECH_MODEL=nova-3-general
# CR_KO_KR_VOICE=ko-KR-Chirp3-HD-Aoede
# CR_KO_KR_TRANSCRIPTION_PROVIDER=Google
# CR_KO_KR_SPEECH_MODEL=telephony
