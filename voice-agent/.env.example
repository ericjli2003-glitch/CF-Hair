# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
# Default model. claude-haiku-4-5 lowers latency and cost (see README).
ANTHROPIC_MODEL=claude-sonnet-5-5
# low keeps replies quick on the phone. Ignored for Haiku.
ANTHROPIC_EFFORT=low
# auto: server-side refusal fallbacks on models that support them. on | off to force.
CLAUDE_FALLBACKS=auto
# 1h (default) keeps the system prompt cached between calls; 5m is cheaper if calls are frequent.
PROMPT_CACHE_TTL=1h

# Booking API (the website in ../website). Same key as the website's AGENT_API_KEY.
BOOKING_API_URL=http://localhost:3000
AGENT_API_KEY=
BOOKING_API_TIMEOUT_MS=5000
CALLER_LOOKUP_TIMEOUT_MS=1500
# true = use the built-in in-memory mock API instead of BOOKING_API_URL
MOCK_API=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only set to false for local testing without Twilio.
TWILIO_VALIDATE_SIGNATURE=true
# Public https URL Twilio uses to reach this server (your ngrok or Fly/Render URL), no trailing slash.
PUBLIC_BASE_URL=
# Live transfer target in E.164, for example the salon's landline or the owner's mobile.
SALON_FORWARD_NUMBER=

# Server
PORT=8080
# Post a low-urgency callback message when a caller hangs up mid-conversation.
CALLBACK_ON_ABANDON=true
# Extra wait after the goodbye before hanging up.
END_CALL_GRACE_MS=1200
# Optional overrides
# WELCOME_GREETING=Hi, thanks for calling CF Hair Salon...
# SALON_JSON_PATH=../shared/salon.json
# LOG_DIR=./logs
# DATA_DIR=./data

# Per-language voice and speech settings (defaults in src/languages.ts). Examples:
# CR_EN_US_VOICE=en-US-Chirp3-HD-Aoede
# CR_ZH_CN_VOICE=cmn-CN-Chirp3-HD-Aoede
# CR_ZH_HK_VOICE=yue-HK-Chirp3-HD-Aoede
# CR_ZH_HK_TRANSCRIPTION_PROVIDER=Deepgram
# CR_ZH_HK_SPEECH_MODEL=nova-3-general
# CR_KO_KR_VOICE=ko-KR-Chirp3-HD-Aoede
# CR_KO_KR_TRANSCRIPTION_PROVIDER=Google
# CR_KO_KR_SPEECH_MODEL=telephony
