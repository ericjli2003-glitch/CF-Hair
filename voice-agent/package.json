{
  "name": "cf-hair-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI phone receptionist for CF Hair Salon (Twilio ConversationRelay + Claude)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx src/simulate.ts",
    "demo": "tsx src/demo.ts",
    "mock-api": "tsx src/mock/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "twilio": "^6.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
